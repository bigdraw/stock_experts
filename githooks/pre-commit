#!/usr/bin/env bash
# long-dev pre-commit hook: block sensitive files / broken STATUS, warn on stale.
# Installed via `git config core.hooksPath githooks` (see scripts/setup-githooks.*).
# Cross-platform: git invokes this with sh (Git Bash on Windows).

set -u

# Resolve repo root (hooks run with cwd == repo root, but be safe).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

cd "$REPO_ROOT" || exit 0

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    # No python — skip silently rather than block commits.
    exit 0
fi

"$PY" scripts/check_discipline.py --pre-commit
rc=$?
if [ $rc -ne 0 ]; then
    echo ""
    echo "pre-commit 纪律检查未通过，commit 已中止。修复后重试。" >&2
    echo "(若需跳过本次检查: git commit --no-verify)" >&2
    exit $rc
fi

# 前端验证（固化测试标准）：有 frontend/ 文件 staged 时跑 vue-tsc + build
# 独立检查退出码，不用 tail 截断——防止 CSS 错误被 chunk warning 掩盖
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=ACM | grep "^frontend/" | head -1)
if [ -n "$STAGED_FRONTEND" ]; then
    echo "--- 前端验证（vue-tsc + build）---"
    bash scripts/verify-frontend.sh
    fe_rc=$?
    if [ $fe_rc -ne 0 ]; then
        echo "前端验证未通过，commit 已中止。" >&2
        echo "(跳过: git commit --no-verify)" >&2
        exit $fe_rc
    fi
fi

exit 0
